{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://academia-rioave.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://academia-rioave.firebaseapp.com/__/firebase/:path*" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
